#
# vltd systemd unit for development installs (VLT-IS-003 TASK 03-00-00-008).
# This is not a package. Install steps: docs/user/dev-service.md.
#
# The DEK: /etc/credstore.encrypted/vlt-dek (made by vlt-dev-init.sh).
# StateDirectoryMode=0700, RuntimeDirectoryMode=0750, SupplementaryGroups=vlt
# and TimeoutStopSec=10 are added to the values of the instruction: vltd
# checks mode 0700 of /var/lib/vltd, the socket directory /run/vltd must
# have mode 0750 and group vlt, and vltd must be a member of vlt to set the
# socket group.

[Unit]
Description=VoltioVolt UPS service (development)
Documentation=https://github.com/abuzer1495/voltiovolt
After=local-fs.target
# VLT-IS-004 QI-1: when this unit enters the "failed" state (for example
# 243/CREDENTIALS: the DEK credential cannot be decrypted, or 3 failed
# starts in 60 seconds), systemd starts vltd-fallback.service. Then vltd runs
# with the Vault state "locked" (SEC-090).
OnFailure=vltd-fallback.service
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
Type=notify
ExecStart=/usr/local/bin/vltd
User=vltd
Group=vltd
SupplementaryGroups=vlt
# VLT-IS-006 TASK 03-00-00-004 step 4: access to /dev/ttyUSB* and /dev/ttyACM*.
# The lines are added to the list (systemd).
SupplementaryGroups=dialout
LoadCredentialEncrypted=vlt-dek:/etc/credstore.encrypted/vlt-dek
StateDirectory=vltd
StateDirectoryMode=0700
RuntimeDirectory=vltd
RuntimeDirectoryMode=0750
UMask=0077
TimeoutStopSec=10
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=243
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
